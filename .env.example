# Instagram / Facebook Graph API
FACEBOOK_ACCESS_TOKEN=your_page_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_professional_account_id
GRAPH_API_VERSION=v21.0

# AI providers (Ollama works; Groq optional)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Neon Postgres
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# X accounts to scrape (comma separated)
X_ACCOUNTS=Nocapmedia,JCFights
MAX_POSTS=15
HEADLESS=true
USER_DATA_DIR=./zalda2
LOGO_PATH=./logo.png
PAGE_NAME=thenextclip.hq